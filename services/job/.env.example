PORT=5003
DB_URL=your_neon_postgres_connection_string
UPLOAD_SERVICE=http://localhost:5001
JWT_SEC=your_jwt_secret
Kafka_Broker=localhost:9092
# Only needed for a hosted broker (e.g. Upstash Kafka) that requires SASL_SSL auth.
# Leave unset for a local/plaintext broker (e.g. via docker-compose).
KAFKA_USERNAME=
KAFKA_PASSWORD=
Redis_url=redis://localhost:6379
