{
  "name": "gateway",
  "version": "1.0.0",
  "description": "API gateway that fronts the HireHeaven microservices with a single origin",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
