{
  "name": "@hireheaven/common",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utilities (error handling, redis, rate limiting, caching, validation, logging, metrics, tokens) for HireHeaven services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/kafkajs": "^1.9.0",
    "@types/node": "^20",
    "express": "^5.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "express": "^5.1.0"
  }
}
