# Shared Dockerfile for every Node service in this npm-workspaces monorepo
# (auth, job, payment, user, utils, gateway). Each service depends on the
# @hireheaven/common workspace package, so the build context must be the
# repo root (not the individual service directory) and the target workspace
# is selected via the SERVICE build arg, e.g.:
#
#   docker build -f Dockerfile.service --build-arg SERVICE=auth -t hireheaven-auth .
#
# docker-compose.yml wires this up per service automatically.

FROM node:22-alpine AS builder

ARG SERVICE

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/common/package.json ./packages/common/
COPY services/${SERVICE}/package.json ./services/${SERVICE}/

RUN npm ci

COPY packages/common ./packages/common
COPY services/${SERVICE} ./services/${SERVICE}

RUN npm run build --workspace=@hireheaven/common
RUN npm run build --workspace=services/${SERVICE}

FROM node:22-alpine

ARG SERVICE

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages/common/dist ./packages/common/dist
COPY --from=builder /app/packages/common/package.json ./packages/common/package.json
COPY --from=builder /app/services/${SERVICE}/dist ./services/${SERVICE}/dist
COPY --from=builder /app/services/${SERVICE}/package.json ./services/${SERVICE}/package.json

WORKDIR /app/services/${SERVICE}

CMD [ "node", "dist/index.js" ]
